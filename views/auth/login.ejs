<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/main.css" />
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .seex-login { width: 100%; max-width: 400px; padding: 24px; }
    .seex-login__logo { text-align: center; margin-bottom: 32px; }
    .seex-login__icon { font-size: 3rem; display: block; margin-bottom: 8px; }
    .seex-login__title { font-size: 1.8rem; font-weight: 700; }
    .seex-login__sub { color: var(--seex-text-muted); font-size: 0.875rem; }
  </style>
</head>
<body>
  <div class="seex-login">
    <div class="seex-login__logo">
      <span class="seex-login__icon">🚨</span>
      <div class="seex-login__title">SEEX</div>
      <div class="seex-login__sub">Smart Emergency Exit System</div>
    </div>

    <div class="seex-card">
      <div class="seex-card__header">
        <span class="seex-card__title">Administrator Sign In</span>
      </div>

      <% if (error) { %>
        <div class="seex-alert seex-alert--error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="seex-form-group">
          <label class="seex-label" for="login-email">Email Address</label>
          <input
            id="login-email"
            class="seex-input"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="admin@seex.local"
            required
          />
        </div>

        <div class="seex-form-group">
          <label class="seex-label" for="login-password">Password</label>
          <input
            id="login-password"
            class="seex-input"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="••••••••"
            required
          />
        </div>

        <button id="login-submit" type="submit" class="seex-btn seex-btn--primary seex-w100">
          Sign In
        </button>
      </form>
    </div>

    <p style="text-align:center; margin-top:20px; font-size:0.75rem; color: var(--seex-text-dim);">
      ⚠️ SEEX is an academic software prototype. NOT a certified life-safety system.
    </p>
  </div>
</body>
</html>
