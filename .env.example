NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=seex_user
DB_NAME=seex_db
MYSQL_ROOT_PASSWORD=password123

# Session secret — change to a long random string in production
SESSION_SECRET=change_me_to_a_random_secret_32chars

# Webhook API key — required in X-API-Key header for POST /api/hazards/report
WEBHOOK_API_KEY=change_me_to_a_random_webhook_key

# Nodemailer SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=smtp_password
ALERT_FROM=alerts@example.com
ADMIN_EMAIL=admin@seex.local

# Twilio SMS
# SMS_MODE=simulate   → logs the SMS to console, no real send (default)
# SMS_MODE=live       → sends real SMS via Twilio
SMS_MODE=simulate
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15005550006
ADMIN_PHONE=+1234567890

# High-density alert: minutes a zone must stay over threshold before alert fires
DENSITY_ALERT_MINUTES=5
