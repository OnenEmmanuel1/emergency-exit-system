<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <!-- Chart.js for historical density charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
<div class="seex-wrapper">
  <%- include('../partials/sidebar', { user, activePage: 'reports' }) %>
  <main class="seex-main">
    <div class="seex-disclaimer">
      ⚠️ <strong>Academic Prototype:</strong> SEEX is NOT a certified life-safety system.
    </div>

    <div class="seex-topbar">
      <div>
        <div class="seex-page-title">Historical Reports</div>
        <div class="seex-page-subtitle">Density trends (last 48 h) and hazard event log — per Section 1.4 daily foot-traffic insights</div>
      </div>
    </div>

    <!-- ── Density charts ─────────────────────────────────────── -->
    <div class="seex-card seex-mb-3">
      <div class="seex-card__header">
          <span class="seex-card__title">Zone Density — Last 48 Hours (People per m², grouped by source)</span>
        </div>
        <p class="seex-text-muted">Each chart legend identifies Manual, Simulated, or Webcam readings. Simulated values are generated data, not camera observations.</p>
      <div id="seex-charts-container">
        <p class="seex-text-muted" style="font-size:0.85rem;">Loading charts…</p>
      </div>
    </div>

    <!-- ── Hazard event log ─────────────────────────────────────── -->
    <div class="seex-card">
      <div class="seex-card__header">
        <span class="seex-card__title">Hazard Event Log (last 100)</span>
      </div>
      <div class="seex-table-wrap">
        <table class="seex-table">
          <thead>
            <tr>
              <th>Zone</th><th>Type</th><th>Status</th>
              <th>Declared At</th><th>Cleared At</th><th>Duration (min)</th>
            </tr>
          </thead>
          <tbody>
            <% for (const h of hazardLog) { %>
            <tr>
              <td><%= h.zoneName %></td>
              <td><%= h.type %></td>
              <td><span class="seex-badge seex-badge--<%= h.status.toLowerCase() %>"><%= h.status %></span></td>
              <td class="seex-mono" style="font-size:0.8rem;"><%= new Date(h.declaredAt).toLocaleString() %></td>
              <td class="seex-mono" style="font-size:0.8rem;"><%= h.clearedAt ? new Date(h.clearedAt).toLocaleString() : '—' %></td>
              <td><%= h.durationMinutes !== null ? h.durationMinutes : '—' %></td>
            </tr>
            <% } %>
            <% if (!hazardLog.length) { %>
            <tr><td colspan="6" style="text-align:center; color:var(--seex-text-dim);">No hazard events recorded.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <footer class="seex-footer">SEEX v1.0 &mdash; Academic Prototype. NOT a certified life-safety system.</footer>
  </main>
</div>

<script>
  // chartData is passed server-side as JSON
  const chartData = <%- chartData %>;
  const container = document.getElementById('seex-charts-container');
  const sourceColors = { Webcam: '#a78bfa', Simulated: '#22d3ee', Manual: '#f59e0b' };

  container.innerHTML = '';

  const zones = Object.keys(chartData);
  if (!zones.length) {
    container.innerHTML = '<p class="seex-text-muted">No density history available yet. The simulator generates readings every minute.</p>';
  } else {
    const grid = document.createElement('div');
    grid.className = 'seex-grid-2';
    container.appendChild(grid);

    zones.forEach((zoneName, i) => {
      const d    = chartData[zoneName];
      const wrap = document.createElement('div');
      const heading = document.createElement('h4');
      heading.textContent = zoneName;
      heading.style.cssText = 'font-size:0.9rem;font-weight:600;margin-bottom:10px;color:var(--seex-text-muted)';
      const canvas = document.createElement('canvas');
      canvas.id = `chart-${i}`;
      canvas.height = 120;
      canvas.setAttribute('aria-label', `Historical density readings for ${zoneName}, separated by input source`);
      wrap.append(heading, canvas);
      grid.appendChild(wrap);
      const datasets = [];
      for (const [source, values] of Object.entries(d.sources)) {
        const color = sourceColors[source] || '#94a3b8';
        datasets.push(
          { label: `Average · ${source}`, data: values.avgDensity, borderColor: color, backgroundColor: color + '22', fill: false, tension: 0.3, pointRadius: 0, borderWidth: 2 },
          { label: `Peak · ${source}`, data: values.peakDensity, borderColor: color, borderDash: [4, 4], fill: false, tension: 0.3, pointRadius: 0, borderWidth: 1 }
        );
      }

      new Chart(canvas, {
        type: 'line',
        data: {
          labels: d.labels.map((l) => {
            const dt = new Date(l);
            return dt.getHours() + ':00';
          }),
          datasets,
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              labels: { color: '#8b90a0', font: { size: 11 } },
            },
          },
          scales: {
            x: {
              ticks: { color: '#555b6e', maxTicksLimit: 8, font: { size: 10 } },
              grid:  { color: '#2e3340' },
            },
            y: {
              beginAtZero: true,
              title: { display: true, text: 'People per m²', color: '#8b90a0' },
              ticks: { color: '#555b6e', font: { size: 10 } },
              grid:  { color: '#2e3340' },
            },
          },
        },
      });
    });
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
