<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="SEEX — Smart Emergency Exit System: Academic prototype for congestion-aware evacuation guidance." />
  <meta name="robots" content="noindex" />
  <!-- Bootstrap 5 via CDN (fallback for UI framework) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
<div class="seex-wrapper">
  <!-- Sidebar -->
  <aside class="seex-sidebar">
    <div class="seex-brand">
      <div class="seex-brand__icon">🚨</div>
      <div>
        <div class="seex-brand__name">SEEX</div>
        <div class="seex-brand__sub">Emergency Exit System</div>
      </div>
    </div>

    <nav class="seex-nav">
      <div class="seex-nav__section">Monitor</div>
      <a href="/dashboard" class="seex-nav__link <%= locals.activePage === 'dashboard' ? 'active' : '' %>">
        <span class="seex-nav__icon">📊</span> Dashboard
      </a>
      <a href="/display" class="seex-nav__link <%= locals.activePage === 'display' ? 'active' : '' %>" target="_blank">
        <span class="seex-nav__icon">🖥️</span> Exit Display
      </a>
      <a href="/reports" class="seex-nav__link <%= locals.activePage === 'reports' ? 'active' : '' %>">
        <span class="seex-nav__icon">📈</span> Reports
      </a>

      <div class="seex-nav__section">Manage</div>
      <a href="/zones" class="seex-nav__link <%= locals.activePage === 'zones' ? 'active' : '' %>">
        <span class="seex-nav__icon">🗺️</span> Building Graph
      </a>
      <a href="/hazards" class="seex-nav__link <%= locals.activePage === 'hazards' ? 'active' : '' %>">
        <span class="seex-nav__icon">⚠️</span> Hazards
      </a>
      <a href="/density" class="seex-nav__link <%= locals.activePage === 'density' ? 'active' : '' %>">
        <span class="seex-nav__icon">👥</span> Density Input
      </a>
    </nav>

    <div class="seex-sidebar-footer">
      <% if (user) { %>
      <div class="seex-user-info seex-mb-1">
        <div class="seex-user-info__name"><%= user.fullName %></div>
        <div class="seex-user-info__role"><%= user.role %></div>
      </div>
      <form method="POST" action="/logout">
        <button type="submit" class="seex-btn seex-btn--ghost seex-btn--sm seex-w100">Sign Out</button>
      </form>
      <% } %>
    </div>
  </aside>

  <!-- Main content -->
  <main class="seex-main">
    <!-- Prototype disclaimer -->
    <div class="seex-disclaimer">
      ⚠️ <strong>Academic Prototype:</strong> SEEX is a decision-support prototype — NOT a certified life-safety system. Not a substitute for NFPA 101/ISO 23601 signage, fire-alarm systems, or certified building safety equipment.
    </div>

    <%- body %>

    <!-- Footer -->
    <footer class="seex-footer">
      SEEX v1.0 &mdash; Smart Emergency Exit System Using Crowd Movement Analytics &mdash; Academic Software Prototype.
      Not validated for real emergency use. &copy; <%= new Date().getFullYear() %>
    </footer>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>
