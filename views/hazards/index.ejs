<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
<div class="seex-wrapper">
  <%- include('../partials/sidebar', { user, activePage: 'hazards' }) %>
  <main class="seex-main">
    <div class="seex-disclaimer">
      ⚠️ <strong>Academic Prototype:</strong> SEEX is NOT a certified life-safety system.
    </div>

    <div class="seex-topbar">
      <div>
        <div class="seex-page-title">Hazard Management</div>
        <div class="seex-page-subtitle">
          Declare or clear hazards. Active hazards exclude a zone from all evacuation routes immediately.
          <br/><small style="color:var(--seex-text-dim)">Webhook for physical sensors: <code>POST /api/hazards/report</code> with <code>X-API-Key</code> header</small>
        </div>
      </div>
    </div>

    <% if (error) { %><div class="seex-alert seex-alert--error"><%= error %></div><% } %>
    <% if (success) { %><div class="seex-alert seex-alert--success"><%= success %></div><% } %>

    <div class="seex-grid-2 seex-mb-3">
      <!-- ── Declare Hazard Form ─────────────────────────────── -->
      <div class="seex-card">
        <div class="seex-card__header">
          <span class="seex-card__title">Declare a Hazard</span>
        </div>
        <% if (!zones.length) { %>
          <div class="seex-alert seex-alert--warning">No non-exit zones found. Add zones first.</div>
        <% } else { %>
        <form method="POST" action="/hazards">
          <div class="seex-form-group">
            <label class="seex-label" for="haz-zone">Affected Zone</label>
            <select id="haz-zone" class="seex-select" name="zoneId" required>
              <option value="">Select zone…</option>
              <% for (const z of zones) { %>
              <option value="<%= z.zoneId %>"><%= z.name %></option>
              <% } %>
            </select>
          </div>
          <div class="seex-form-group">
            <label class="seex-label" for="haz-type">Hazard Type</label>
            <select id="haz-type" class="seex-select" name="type" required>
              <option value="Fire">🔥 Fire</option>
              <option value="Smoke">💨 Smoke</option>
              <option value="StructuralDamage">🏗️ Structural Damage</option>
              <option value="Security">🔒 Security Threat</option>
            </select>
          </div>
          <div class="seex-alert seex-alert--warning" style="font-size:0.82rem; margin-bottom:14px;">
            Declaring a hazard immediately excludes the zone from virtual route calculations and initiates configured administrator alert attempts. It does not control occupants or physical equipment.
          </div>
          <button id="haz-declare-btn" type="submit" class="seex-btn seex-btn--danger">⚠️ Declare Hazard</button>
        </form>
        <% } %>
      </div>

      <!-- ── API Webhook docs ───────────────────────────────── -->
      <div class="seex-card">
        <div class="seex-card__header">
          <span class="seex-card__title">Sensor Integration Webhook</span>
        </div>
        <p class="seex-text-muted seex-mb-2" style="font-size:0.85rem;">
          A physical IoT sensor controller (smoke detector, temperature sensor) can
          report hazards programmatically via this endpoint. The software integration
          point is complete — hardware integration is a future deployment step.
        </p>
        <pre class="seex-code" style="display:block; padding:12px; line-height:1.5; font-size:0.8rem; overflow-x:auto;">POST /api/hazards/report
Headers:
  X-API-Key: &lt;WEBHOOK_API_KEY from .env&gt;
  Content-Type: application/json

Body:
{
  "zoneId": 3,
  "type": "Smoke"
}

Response 201:
{
  "hazardId": 7,
  "zoneId": 3,
  "type": "Smoke",
  "status": "Active"
}</pre>
      </div>
    </div>

    <!-- ── Hazard event log ───────────────────────────────────── -->
    <div class="seex-card">
      <div class="seex-card__header">
        <span class="seex-card__title">Hazard Event Log</span>
      </div>
      <div class="seex-table-wrap">
        <table class="seex-table">
          <thead>
            <tr><th>Zone</th><th>Type</th><th>Status</th><th>Declared By</th><th>Declared At</th><th>Cleared At</th><th></th></tr>
          </thead>
          <tbody>
            <% for (const h of hazards) { %>
            <tr>
              <td><strong><%= h.zoneName %></strong></td>
              <td><%= h.type %></td>
              <td><span class="seex-badge seex-badge--<%= h.status.toLowerCase() %>"><%= h.status %></span></td>
              <td><% if (h.declaredByName) { %><%= h.declaredByName %><% } else { %><span class="seex-text-muted">Webhook</span><% } %></td>
              <td class="seex-mono" style="font-size:0.8rem;"><%= new Date(h.declaredAt).toLocaleString() %></td>
              <td class="seex-mono" style="font-size:0.8rem;"><%= h.clearedAt ? new Date(h.clearedAt).toLocaleString() : '—' %></td>
              <td>
                <% if (h.status === 'Active') { %>
                <form method="POST" action="/hazards/<%= h.hazardId %>/clear" style="display:inline"
                      onsubmit="return confirm('Clear this hazard?')">
                  <button id="haz-clear-<%= h.hazardId %>" type="submit" class="seex-btn seex-btn--success seex-btn--sm">✓ Clear</button>
                </form>
                <% } %>
              </td>
            </tr>
            <% } %>
            <% if (!hazards.length) { %>
            <tr><td colspan="7" style="text-align:center; color:var(--seex-text-dim);">No hazard events recorded.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <footer class="seex-footer">SEEX v1.0 &mdash; Academic Prototype. NOT a certified life-safety system.</footer>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="/socket.io/socket.io.js"></script>
</body>
</html>
